# StockSense Server Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="stocksense-hackathon-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
